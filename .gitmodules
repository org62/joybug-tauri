[submodule "external/joybug2"]
	path = external/joybug2
	url = https://github.com/org62/joybug-core.git
	# joybug2 has a single long-lived branch, so `git submodule update --remote`
	# always means "pull in the latest core". Builds use the pinned gitlink; only
	# an explicit --remote moves it.
	branch = main
